<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EDAAMS_Desktop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EDAAMS_Desktop.styles.css" asp-append-version="true" />

    <!--Link to font awesome API-->
    <script src="https://kit.fontawesome.com/3182cd8206.js" crossorigin="anonymous"></script>

    <!--Link to chart Js-->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EDAAMS_Desktop</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home <i class="fa-solid fa-house"></i></a>
                        </li>

                        <!--Links To Log-In Page-->
                        <li class="nav-item">
                            <a class="nav-link text-dark" data-bs-toggle="modal" data-bs-target="#modalDivLogIn">Log-In <i class="fa-solid fa-circle-user"></i></a>

                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!--Modal used for Logging In-->
    <div id="modalDivLogIn" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body text-start d-flex flex-column justify-content-center">
                    @if (1 == 2)
                    {
                        <h4>Log-In Details</h4>

                        <form class="d-flex flex-column p-2">
                            <label>Username:</label>
                            <input type="text" required />

                            <label>Password:</label>
                            <input type="text" required />
                            <br />

                            <button class="btn">Log In</button>
                            <a class="a" asp-controller="User" asp-action="CRUDUser">Don't Have an account? Click Here <i class="fa-solid fa-user-secret"></i></a>

                        </form>

                    }
                    else
                    if (Context.Session.GetString("role") != "" && Context.Session.GetString("role") != null)
                    {
                        <form class="d-flex flex-column p-2" asp-controller="User" asp-action="LogOut" method="post">
                            <h4>Logged In</h4>
                            <h6>WELCOME <strong>@Context.Session.GetString("role")</strong>, Have a nice day ☺</h6>

                            <br />
                            <button type="submit" class="btn">Log-Out</button>

                        </form>

                    }
                    else
                    {
                    <!--Only used for prototype-->
                    <h4>Log-In Details (Prototype Version)</h4>

                    <form class="d-flex flex-column p-2" asp-controller="User" asp-action="LogIn" method="post">
                        <h6>Log In As:</h6>

                        <select name="role">
                            <option value="ecr">EDUCATOR</option>
                            <option value="std">STUDENT</option>
                            <option value="adn">ADMIN</option>

                        </select>
                        <br />

                        <button type="submit" class="btn">Log In</button>
                        <a class="a" asp-controller="User" asp-action="CRUDUser">Don't Have an account? Click Here <i class="fa-solid fa-user-secret"></i></a>

                    </form>

                    }
                    
                </div>

            </div>

        </div>
    </div>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EDAAMS_Desktop - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

