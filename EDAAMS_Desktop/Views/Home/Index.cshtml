@{
    ViewData["Title"] = "Home Page";

}

<!--Contains non interactive display elements-->
<div class="d-flex flex-column container-fluid flex-fill align-items-center m">
    <img class="img-fluid h-25 w-25" src="images/logo.png" alt="Edendale Logo"/>
    <p class="align-self-center h-auto fw-bold">EDENDALE DIGITAL ASSESSMENT AND MARKING SYSTEM</p>

</div>

<br />

<!--DIV Containing the main buttons used to traverse the application-->
<div class="d-flex flex-row flex-fill container-fluid align-content-between gap-3" style="overflow-x: auto; overflow-y: hidden;">
    @if (Context.Session.GetString("role") == "EDUCATOR")
    {
    <!--Calls Modal that displays Assessment related traversal options-->
    <button data-bs-toggle="modal" data-bs-target="#modalDivAssessments"
            class="d-flex flex-column btn border gap-1 col">

        <h1><i class="fa-solid fa-file"></i></h1>
        <p>Assessments</p>

    </button>

    <!--Calls Modal that displays Student related traversal options-->
    <button data-bs-toggle="modal" data-bs-target="#modalDivStudents"
            class="d-flex flex-column btn border gap-1 col">

        <h1><i class="fa-solid fa-user-graduate"></i></h1>
        <p>Students</p>

        </button>

    }
    else
    if (Context.Session.GetString("role") == "STUDENT")
    {
        <button data-bs-toggle="modal" data-bs-target="#modalStartAssessment" class="d-flex flex-column btn border gap-1 col">

            <h1><i class="fa-solid fa-hourglass-start"></i></h1>
            <p>Start Assessment</p>

        </button>

    }
    else
    if (Context.Session.GetString("role") == "ADMIN")
    {
        <a asp-controller="Student" asp-action="CRUDStudent" class="d-flex flex-column btn border gap-1 col">

            <h1><i class="fa-solid fa-plus"></i></h1>
            <p>Create Student</p>

        </a>

    }
    else
        if (Context.Session.GetInt32("HaveVisitedHomePage") != 1)
    {
        <script>
            alert("Please Log-In to make use of our provided functionalities ☺")         
            fetch('@Url.Action("SetVisited", "Home")', { method: 'POST' });
           
        </script>

    }

    <a asp-controller="Home" asp-action="Settings" class="d-flex flex-column btn border gap-1 col">

        <h1><i class="fa-solid fa-gear"></i></h1>
        <p>Settings</p>

    </a>

    <a asp-controller="Home" asp-action="Privacy" class="d-flex flex-column btn border gap-1 col">

        <h1><i class="fa-solid fa-shield-halved"></i></h1>
        <p>Privacy</p>

    </a>
    
</div>

<br />

<div id="modalDivStudents" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-row flex-fill container-fluid align-content-between gap-3" style="overflow-x: auto; overflow-y: hidden;">
                <a asp-controller="Student" asp-action="Index" class=" d-flex flex-column btn border gap-1 col">

                    <h1><i class="fa-solid fa-clipboard"></i></h1>
                    <p>Student Details</p>

                </a>

                <a asp-controller="Statistics" asp-action="StudentStats" class="d-flex flex-column btn border gap-1 col">

                    <h1><i class="fa-solid fa-chart-simple"></i></h1>
                    <p>StudentStatistics</p>

                </a>

            </div>

        </div>

    </div>

</div>

<div id="modalDivAssessments" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-row flex-fill container-fluid align-content-between gap-3" style="overflow-x: auto; overflow-y: hidden;">
                <a asp-controller="Assessment" asp-action="CreateAssessment" class="d-flex flex-column btn border gap-1 col">

                    <h1><i class="fa-solid fa-plus"></i></h1>
                    <p>Create Assessment</p>

                </a>

                <a asp-controller="Assessment" asp-action="MarkAssessment" class="d-flex flex-column btn border gap-1 col">

                    <h1><i class="fa-solid fa-list-check"></i></h1>
                    <p>Mark Assessment</p>

                </a>

            </div>

        </div>

    </div>

</div>

<div id="modalStartAssessment" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid align-content-between gap-3" style="overflow-x: auto; overflow-y: hidden;">
                <h4>Assessment Details</h4>

                <form class="d-flex flex-column" asp-controller="Assessment" asp-action="StartAssessment" method="post">
                    <h6>Please Enter the Assessment ID of the Assessment You Wish to Partake in.</h6>
                    <input name="assID"type="text" required/>
                    <br />

                    <button class="btn">Start Assessment</button>

                </form>

            </div>

        </div>

    </div>

</div>

