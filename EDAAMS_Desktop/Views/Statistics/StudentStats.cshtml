@{
    ViewData["Title"] = "Student Statistics Page";
}

@if (Context.Session.GetString("role") != "EDUCATOR")
{
    <script>
        alert("Please Log-In as an EDUCATOR to make use of this functionality!!!");
        window.location.href = '@Url.Action("Index", "Home")';

    </script>

}

@if (Context.Session.GetString("role") != "EDUCATOR")
{
    <script>
        alert("Please Log-In as an EDUCATOR to make use of this functionality!!!");
        window.location.href = '@Url.Action("Index", "Home")';

    </script>

}

<form id="topPerforming" class="d-flex flex-column container-fluid border p-2 gap-2">
    <h4 class="align-self-start">Top Performers:</h4>

    <div id="availableTopPerformersViewer" class="d-flex flex-column container-fluid border p-2" style="overflow-x:hidden; overflow-y: scroll;">
        @if (1 == 1)
        {
            <h6>No Grades/Students Uploaded yet (Not Available In Prototype)</h6>

        }

    </div>

    <div class="d-flex flex-row">
        <button data-bs-toggle="modal" data-bs-target="#modalDivTopPerformingFilter" type="button" class="align-self-start btn">Filter<i class="fa-solid fa-filter"></i></button>

    </div>

</form>
<br />

<div id="gradeAvgStats" class="d-flex flex-column container-fluid border p-2">
    <h4 class="align-self-start">Grade Averages</h4>

    <div id="studentDetailsViewer" class="d-flex flex-column container-fluid  border p-2" style="overflow-x:hidden; overflow-y: scroll;">
        @if (1 != 1)
        {
            <h6>No Grades/Students Uploaded yet</h6>

        }
        else
        {
            <!--Graphing to show how averages have changes over a time period-->
            <div style="height: 25dvh; width: 100%;">
                <canvas id="gradeAverageChart"></canvas>
            </div>

        }

    </div>
    <br />

    <div class="d-flex flex-row gap-2">
        <div class="d-flex flex-column align-content-between gap-2">
            <div class="d-flex flex-row gap-1">
                <label>X-Axis: </label>
                <select>
                    <option>Month</option>

                </select>

            </div>

            <div class="d-flex flex-row gap-1">
                <label>Ratio X-Axis: </label>
                <select>
                    <option>1:1</option>

                </select>

            </div>

        </div>
        <br />

        <div class="d-flex flex-column align-content-between gap-2">
            <div class="d-flex flex-row gap-1">
                <label>Y-Axis: </label>
                <select>
                    <option>AVG Grade</option>

                </select>

            </div>

            <div class="d-flex flex-row gap-1">
                <label>Ratio Y-Axis: </label>
                <select>
                    <option>1:50</option>

                </select>

            </div>

        </div>

    </div>

</div>

<div id="modalDivTopPerformingFilter" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid gap-2">
                <h4 class="align-self-start">Filter By:</h4>
                <br />

                <form class="d-flex flex-column">
                    <select>
                        <option>Options <i class="fa-solid fa-arrow-down"></i></option>
                        <option>No Filtering Available Within Prototype</option>

                    </select>
                    <br />

                    <label>Value:</label>
                    <input type="text" required/>
                    <br />

                    <button class="btn">Filter</button>

                </form>

            </div>

        </div>

    </div>

</div>

<script>
    const ctx = document.getElementById('gradeAverageChart');

    new Chart(ctx, {
        type: 'line',
            data: {
                labels: [
                    'January',
                    'February',
                    'March',
                    'April',
                    'May',
                    'June'

                ],

                datasets: [{
                    label: 'Average Grade',
                    data: [62, 67, 65, 71, 74, 78],
                    borderWidth: 2,
                    tension: 0.3,
                    fill: false

                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,

                        title: {
                            display: true,
                            text: 'Average Grade (%)'

                        }
                    },

                    x: 
                    {
                        title: 
                        {
                            display: true,
                            text: 'Month'
                        }
                    }
                }
            }

    });

</script>