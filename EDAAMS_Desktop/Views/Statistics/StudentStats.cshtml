@{
    ViewData["Title"] = "Student Statistics Page";
}

<form id="topPerforming" class="d-flex flex-column container-fluid border p-2 gap-2">
    <h4 class="align-self-start">Top Performers:</h4>

    <div id="availableTopPerformersViewer" class="d-flex flex-column container-fluid border p-2" style="overflow-x:hidden; overflow-y: scroll;">
        @if (1 == 1)
        {
            <h6>No Grades/Students Uploaded yet</h6>

        }

    </div>

    <div class="d-flex flex-row">
        <button data-bs-toggle="modal" data-bs-target="#modalDivTopPerformingFilter" type="button" class="align-self-start btn">Filter<i class="fa-solid fa-filter"></i></button>

    </div>

</form>
<br />

<div id="gradeAvgStats" class="d-flex flex-column container-fluid border p-2">
    <h4 class="align-self-start">Grade Averages</h4>

    <div id="studentDetailsViewer" class="d-flex flex-column container-fluid  border p-2" style="overflow-x:hidden; overflow-y: scroll;">
        @if (1 == 1)
        {
            <h6>No Grades/Students Uploaded yet</h6>

        }
        else
        {
            <!--Graphing to show how averages have changes over a time period-->

        }

    </div>
    <br />

    <div class="d-flex flex-column container-fluid gap-2">
        <div class="d-flex flex-row gap-1">
            <label>X-Axis: </label>
            <select>
                <option>Options <i class="fa-solid fa-arrow-down"></i></option>

            </select>

        </div>

        <div class="d-flex flex-row gap-1">
            <label>X-Axis: </label>
            <select>
                <option>Options <i class="fa-solid fa-arrow-down"></i></option>

            </select>

        </div>

        <div class="d-flex flex-row gap-1">
            <label>Y-Axis: </label>
            <select>
                <option>Options <i class="fa-solid fa-arrow-down"></i></option>

            </select>

        </div>

    </div>

</div>

<div id="modalDivTopPerformingFilter" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid gap-2">
                <h4 class="align-self-start">Filter By:</h4>
                <br />

                <form class="d-flex flex-column">
                    <select>
                        <option>Options <i class="fa-solid fa-arrow-down"></i></option>

                    </select>
                    <br />

                    <label>Value:</label>
                    <input type="text" required/>
                    <br />

                    <button class="btn">Filter</button>

                </form>

            </div>

        </div>

    </div>

</div>