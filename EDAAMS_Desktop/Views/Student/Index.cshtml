@using EDAAMS_Desktop.Models.StudentModels
@model StudentSubjectVM

@{
    ViewData["Title"] = "Student Details Page";
}

@if (Context.Session.GetString("role") != "EDUCATOR")
{
    <script>
        alert("Please Log-In as an EDUCATOR to make use of this functionality!!!");
        window.location.href = '@Url.Action("Index", "Home")';

    </script>

}

<div id="studentDetails" class="d-flex flex-column container-fluid border p-2">
    <h4 class="align-self-start">Student Details</h4>

    <div id="studentDetailsViewer" class="d-flex flex-column container-fluid">
        @if (Model == null)
        {
            <h6>No Student Details Chosen yet</h6>

        }
        else
        {
            <label>Student ID:</label>
            <input class="disabled" type="text" value="@Model.Student.StudentID" readonly/>

            <label>Student Full Name:</label>
            <input class="disabled" type="text" value="@Model.Student.StudentFullName" readonly />

            <label>Current Year of Study:</label>
            <input class="disabled" type="text" value="@Model.Student.CurrentYearOfStudy" readonly />

            <label>Current Grade Average:</label>
            <input class="disabled" type="number" value="@Model.Student.GradeAvg" readonly />

            @if (1 == 1)
            {
                <label>Ranking within Year Group:</label>
                <input class="disabled" value="N/A" readonly />

            }

            @if (Model.Student.GradeAvg > 30)
            {
                <label>Will Advance?</label>
                <input class="disabled" type="text" value="TRUE" readonly />

            }
            else
            {
                <label>Will Advance?</label>
                <input class="disabled" type="text" value="FALSE" readonly />

            }

        }

    </div>
    <br />

    <div class="d-flex flex-row container-fluid align-content-between gap-2">
        <a asp-controller="Student" asp-action="Index" class="btn">Clear <i class="fa-solid fa-rectangle-xmark"></i></a>
        <button data-bs-toggle="modal" data-bs-target="#modalDivSelectStudent" class="align-self-end btn">Select New Student <i class="fa-solid fa-user-graduate"></i></button>

    </div>

</div>
<br />

<div id="studentGrades" class="d-flex flex-column container-fluid border p-2">
    <h4 class="align-self-start">Grades</h4>
 
    <div id="availableGradesViewer" class="d-flex flex-column container-fluid border p-2" style="overflow-x:hidden; overflow-y: scroll;">
        @if (1 == 1)
        {
            <h6>No Grades Uploaded yet (Not Available Within Prototype)</h6>

        }

    </div>
    <br />

    <div class="d-flex flex-row">
        <button data-bs-toggle="modal" data-bs-target="#modalDivGradeFilter" class="align-self-start btn">Filter <i class="fa-solid fa-filter"></i></button>

    </div>

</div>

<div id="modalDivSelectStudent" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid gap-2">
                <h4 class="align-self-start">Find Student:</h4>
          
                <form class="d-flex flex-column" asp-controller="Student" asp-action="FindStudent" method="get">
                    <select>
                        <option>Student</option>

                    </select>
                    <br />

                    <label>Value:</label>
                    <input name="studID" type="text" value="Example Student 1" readonly/>
                    <br />

                    <button type="submit" class="btn">Filter</button>

                </form>

            </div>

        </div>

    </div>

</div>

<div id="modalDivGradeFilter" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid gap-2">
                <h4 class="align-self-start">Filter By:</h4>
              
                <form class="d-flex flex-column">
                    <select>
                        <option>Options <i class="fa-solid fa-arrow-down"></i></option>
                        <option>No Filtering Available Within Prototype</option>

                    </select>
                    <br />

                    <label>Value:</label>
                    <input type="text" required />
                    <br />

                    <button class="btn">Filter</button>

                </form>

            </div>

        </div>

    </div>

</div>

