@{
    ViewData["Title"] = "Create Assessment Page";
}

<div id="controls" class="container-fluid d-flex flex-row flex-fill">
    <div class="d-flex flex-column">
        <form>
            <button>FINALISE & SAVE</button>

        </form>

        <form>
            <button>CLEAR ALL</button>

        </form>
        
    </div>
    
</div>

<div id="assessmentPreview" class="container-fluid d-flex flex-column border-1">
    <!--Will Display then exam's ID and then a unique student identifier when the xam is hosted now just a preview-->
    <div id="details">
        <div>
            <label>Assessment ID:</label>
            <input />

        </div>

        <div>
            <label>Student ID:</label>
            <input />

        </div>

    </div>

    <!--For Loop that reads from db then populates a list of exam questions-->
    @if (1 == 1)
    {
        <h3>NO QUESTIONS ADDED!!!</h3>

    }

    <button button data-bs-toggle="modal" data-bs-target="#modalDivQuestions">Add Question</button>
    
</div>

<!--Modal Contains a list of available test's the ability to add a new question and the redirection to create a new one-->
<div id="modalDivQuestions" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body text-start d-flex flex-column justify-content-center">
                <div class="d-flex flex-fill flex-row">
                    <button>FILTER</button>

                    <select>
                        <option value="">Options:</option>

                    </select>

                </div>

                <h1>NO QUESTIONS AVAILABLE, Please add one☺.</h1>

                <div class="d-flex flex-fill flex-row">
                    <form>
                        <button>Add Selected To Exam</button>

                    </form>

                    <!--Redirects the user to the page where they can add a new question to the available pool-->
                    <form asp-controller="Assessment" asp-action="CRUDQuestion">
                        <button>CREATE NEW QUESTION</button>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>
