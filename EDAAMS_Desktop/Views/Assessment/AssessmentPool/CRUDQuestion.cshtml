@{
    ViewData["Title"] = "CRUD Question Page";
}

@if (Context.Session.GetString("role") != "EDUCATOR")
{
    <script>
        alert("Please Log-In as an EDUCATOR to make use of this functionality!!!");
        window.location.href = '@Url.Action("Index", "Home")';

    </script>

}

<div class="d-flex flex-column border p-2">

    <h6 class="align-self-start">PREVIOUS QUESTIONS</h6>

    <div class="d-flex flex-fill flex-row align-content-between gap-1 mb-1">
        <button class="btn">FILTER</button>

        <select>
            <option value="">Options:</option>

        </select>

    </div>

    <div id="previousQuestions" class="container-fluid d-flex flex-column h-50 p-2 border" style="overflow-x:hidden; overflow-y: scroll;">
        <!--For Loop that reads from db then populates a list of exam questions-->
        @if (1 == 1)
        {
            <h6>NO PREVIOUS QUESTIONS AVAILABLE.</h6>

        }

    </div>

    <br />

    <!--CRUD actions regarding the exam questions available trough this section-->
    <div class="d-flex flex-fill flex-row align-content-between gap-3">
        <form>
            <button class="btn">Update Question Details</button>

        </form>

        <form>
            <button class="btn">Delete</button>

        </form>

    </div>

</div>
<br />

<div class="d-flex flex-column p-2 border">
    <h6 class="align-self-start">Question Details:</h6>

    <form class="d-flex flex-fill flex-column" asp-controller="Assessment" asp-action="CreateAssessment">
        <label>Main Question:</label>
        <input type="text" required/>

        <div class="d-flex flex-row align-content-between gap-1">
            <label>Make MultiChoice? </label>
            <input input type="checkbox" id="multiChoiceCheckbox" />
            
            <!--A List of the multiple choice questions that shows if the question is multi choice-->
            @if (1==1)
            {
                
            }

        </div>

        <br />

        <button class="btn">Add Question to Pool</button>

    </form>

</div>

<!--Modal Contains a list of the multichoice questions the user adds-->
<div id="modalDivQuestions" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body text-start d-flex flex-column justify-content-center">
                <h3>Multi Choice Questions:</h3>

                <form class="d-flex flex-column">
                    <label>A:</label>
                    <input type="text" required />

                    <label>B:</label>
                    <input type="text" required />

                    <label>C:</label>
                    <input type="text" required />

                    <label>D:</label>
                    <input type="text" required />
                    <br />

                    <button class="btn">SAVE QUESTION SCHEMA</button>

                </form>

            </div>

        </div>

    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const checkbox = document.getElementById("multiChoiceCheckbox");
        const modalElement = document.getElementById("modalDivQuestions");
        const modal = new bootstrap.Modal(modalElement);

        checkbox.addEventListener("change", function () {

            if (this.checked) {
                modal.show();
            } else {
                modal.hide();
            }

        });

    });

</script>