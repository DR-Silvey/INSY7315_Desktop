<div class="d-flex flex-column">
    <label>Question Details:</label>

    <form class="d-flex flex-fill flex-row" asp-controller="Assessment" asp-action="CreateAssessment">
        <label>Main Question:</label>
        <input />

        <div class="d-flex flex-row">
            <input input type="checkbox" id="multiChoiceCheckbox" />
            <label>Make MultiChoice?</label>

            <!--Al List of the multiple choice questions that shows if the question is multi choice-->
            <div>

            </div>

        </div>

        <button>Add Question to Pool</button>

    </form>

</div>

<!--Modal Contains a list of the multichoice questions the user adds-->
<div id="modalDivQuestions" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body text-start d-flex flex-column justify-content-center">
                <h3>Multi Choice Questions:</h3>

                <form>
                    <label>A:</label>
                    <input />

                    <label>B:</label>
                    <input />

                    <label>C:</label>
                    <input />

                    <label>D:</label>
                    <input />

                </form>

                <button>SAVE QUESTION SCHEMA</button>

            </div>

        </div>

    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const checkbox = document.getElementById("multiChoiceCheckbox");
        const modalElement = document.getElementById("modalDivQuestions");
        const modal = new bootstrap.Modal(modalElement);

        checkbox.addEventListener("change", function () {

            if (this.checked) {
                modal.show();
            } else {
                modal.hide();
            }

        });

    });

</script>