@{
    ViewData["Title"] = "Mark Assessment Page";
}

@if (Context.Session.GetString("role") != "EDUCATOR")
{
    <script>
        alert("Please Log-In as an EDUCATOR to make use of this functionality!!!");
        window.location.href = '@Url.Action("Index", "Home")';

    </script>

}

<form id="assessmentPages" class="d-flex flex-column container-fluid border p-2">
    <h4 class="align-self-start">Assessment Pages</h4>

    <div id="assessmentPageViewer" class="d-flex flex-column container-fluid" style="overflow-x:hidden; overflow-y: scroll;">
        @if (1 == 1)
        {
            <h6>No Assessment Pages Uploaded yet</h6>

        }

    </div>

    <br />

    <button class="btn">Upload Assessment</button>

</form>

<div id="assessmentPool" class="d-flex flex-column container-fluid border p-2">
    <h4 class="align-self-start">Assessments</h4>

    <div id="availableAssessmentViewer" class="d-flex flex-column container-fluid" style="overflow-x:hidden; overflow-y: scroll;">
        @if (1 == 1)
        {
            <h6>No Assessments Uploaded yet</h6>   
            
        }

    </div>

    <br />

    <div class="d-flex flex-row container-fluid align-content-between gap-2">
        <button data-bs-toggle="modal" data-bs-target="#modalDivAssessmentFilter" class="align-self-start btn">Filter <i class="fa-solid fa-filter"></i></button>
        <button data-bs-toggle="modal" data-bs-target="#modalDivNewAssessment" class="align-self-end btn">Add New Assessment <i class="fa-solid fa-plus"></i></button>

    </div>

</div>

<div id="modalDivAssessmentFilter" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid gap-2">
                <h4 class="align-self-start">Filter By:</h4>

                <form class="d-flex flex-column gap-1 p-2">
                    <select>
                        <option>Options <i class="fa-solid fa-arrow-down"></i></option>

                    </select>

                    <label>Value:</label>
                    <input />

                    <br />

                    <button class="btn">Filter</button>

                </form>

            </div>

        </div>

    </div>

</div>

<div id="modalDivNewAssessment" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid gap-2">
                <h4 class="align-self-start">Uploaded Pages</h4>

                <form id="uploadedAssessmentPages" class="d-flex flex-column gap-1">
                    <div id="uploadedAssessmentPagesViewer" class="d-flex flex-column container-fluid" style="overflow-x:scroll; overflow-y: scroll;">

                    </div>

                    <div class="d-flex flex-row align-content-between gap-3">
                        <input class="btn" id="imgUpload" type="file"/>

                        <button class="btn">Upload Image <i class="fa-solid fa-image"></i></button>

                    </div>
                    
                 </form>

                 <form class="d-flex flex-column p-2 border">
                    <div class="d-flex flex-column container-fluid" style="overflow-x:hidden; overflow-y: auto;">
                        <h6 class="align-self-start">Test Details:</h6>

                        <label>Assessment ID: *</label>
                        <input type="text" required/>

                        <label>Student ID: *</label>
                        <input type="text" required  />

                        <label>Marked Grade (if applicable):</label>
                        <input type="number"/>

                        <div class="d-flex flex-row gap-1">
                            <label>AUTO MARK TEST </label>
                            <input type="checkbox" />

                        </div>
                        
                     </div>

                     <br />
                    <button class="btn">Upload Test Details <i class="fa-solid fa-upload"></i></button>

                 </form>

            </div>

        </div>

    </div>

</div>