@using EDAAMS_Desktop.Models.AssessmentModels
@model AssessmentVM

@{
    ViewData["Title"] = "Mark Assessment Page";
}

@if (Context.Session.GetString("role") != "EDUCATOR")
{
    <script>
        alert("Please Log-In as an EDUCATOR to make use of this functionality!!!");
        window.location.href = '@Url.Action("Index", "Home")';

    </script>

}

<div id="assessmentPool" class="d-flex flex-column container-fluid border p-2">
    <h4 class="align-self-start">Assessments</h4>

    <div id="availableAssessmentViewer" class="d-flex flex-column container-fluid" style="overflow-x:scroll; overflow-y: scroll; max-height: 25dvh;">
        <h6 id="noAssessmentsMessage">

        </h6>

        <table class="table">
            <tr>
                <th>Assessment ID</th>
                <th>Student ID</th>
                <th>Marked Grade</th>
                <th>Auto Mark Grade</th>
                <th>Images</th>

            </tr>

            <tbody>
            </tbody>

        </table>
              

    </div>

    <br />

    <div class="d-flex flex-row container-fluid align-content-between gap-2">
        <button data-bs-toggle="modal" data-bs-target="#modalDivAssessmentFilter" class="align-self-start btn">Filter <i class="fa-solid fa-filter"></i></button>
        <button data-bs-toggle="modal" data-bs-target="#modalDivNewAssessment" class="align-self-end btn">Add New Assessment <i class="fa-solid fa-plus"></i></button>

    </div>

</div>

<div id="modalDivAssessmentFilter" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid gap-2">
                <h4 class="align-self-start">Filter By:</h4>

                <form class="d-flex flex-column gap-1 p-2">
                    <select>
                        <option>Options <i class="fa-solid fa-arrow-down"></i></option>
                        <option>No Filtering Available Within Prototype</option>

                    </select>

                    <label>Value:</label>
                    <input />

                    <br />

                    <button class="btn">Filter</button>

                </form>

            </div>

        </div>

    </div>

</div>

<div id="modalDivNewAssessment" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body d-flex flex-column flex-fill container-fluid gap-2">
                <h4 class="align-self-start">Uploaded Pages</h4>

                <form id="uploadedAssessmentPages" class="d-flex flex-column gap-1">
                    <div id="uploadedAssessmentPagesViewer" class="d-flex flex-row align-content-between gap-1" style="overflow-x:scroll; overflow-y: hidden; max-height: 25dvh;">

                    </div>

                    <div class="d-flex flex-row align-content-between gap-3">
                        <input class="btn" id="imgUpload" type="file"/>

                        <button id="uploadImageBtn" type="button" class="btn">Upload Image <i class="fa-solid fa-image"></i></button>

                    </div>
                    
                 </form>

                <form id="uploadTest" class="d-flex flex-column p-2 border">
                    <div class="d-flex flex-column container-fluid" style="overflow-x:hidden; overflow-y: auto;">
                        <h6 class="align-self-start">Test Details:</h6>

                        <label>Assessment ID: *</label>
                        <input name="AssessmentID" type="text" required />

                        <label>Student ID: *</label>
                        <input name="StudentID" type="text" required />

                        <label>Marked Grade (if applicable):</label>
                        <input name="MarkedGrade" type="number" />

                        <div class="d-flex flex-row gap-1">
                            <label>AUTO MARK TEST </label>
                            <input name="autoMarkGrade" type="checkbox" />

                        </div>
                        
                     </div>
                     <br />

                    <button id="uploadTestDetails" type="button" class="btn">Upload Test Details <i class="fa-solid fa-upload"></i></button>

                 </form>

            </div>

        </div>

    </div>

</div>
                      
<!--Script to load the success Toast-->
<script>
    document.getElementById("uploadTest").addEventListener("submit", function (event) {
        //Stopping the submit action from triggering
        event.preventDefault();

        //Displaying the Toast
        const toastElement = document.getElementById("studentSavedToast");
        const toast = new bootstrap.Toast(toastElement);

        toast.show();

        //Clearing the Form
        this.querySelectorAll("input").forEach(input => {
            if (input.type === "checkbox") {
                input.checked = false;

            }
            else
            if (!input.readOnly) {
                input.value = "";

            }

        });

    });

</script>

<script>
    document.getElementById("uploadImageBtn").addEventListener("click", function () {
        const fileInput = document.getElementById("imgUpload");
        const viewer = document.getElementById("uploadedAssessmentPagesViewer");

        //If no file was uploaded exit the method
        if (fileInput.files.length === 0) {
            return;

        }

        const file = fileInput.files[0];

        //If the file is not an image
        if (!file.type.startsWith("image/")) {
            return;

        }

        const reader = new FileReader();
        reader.onload = function (event) {
            const imageContainer = document.createElement("div");
                imageContainer.classList.add("position-relative");

            const image = document.createElement("img");
                image.src = event.target.result;
                image.style.maxHeight = "25dvh";
                image.style.maxWidth = "17dvh";
                image.classList.add("border", "rounded");
                imageContainer.appendChild(image);
                viewer.appendChild(imageContainer);

        };

        reader.readAsDataURL(file);

        //Clearing the input that hosts the chosen file
        fileInput.value = "";

    });

</script>

<script>
    const savedAssessments = new Set();

    document.getElementById("uploadTestDetails")
        .addEventListener("click", function () {

        const assessmentID = document.querySelector('[name="AssessmentID"]').value;
        const studentID = document.querySelector('[name="StudentID"]').value;
        const markedGrade = document.querySelector('[name="MarkedGrade"]').value;
        const autoMark = document.querySelector('[name="autoMarkGrade"]').checked;

        savedAssessments.add(assessmentID);

        displayAssessments(assessmentID, studentID, markedGrade, autoMark);

        //Clearing the input form after upload of assessmnent
        document.getElementById("uploadTest").reset();

        const modal = bootstrap.Modal.getInstance( document.getElementById("modalDivNewAssessment"));
        if (modal) {
            modal.hide();

        }
    });

</script>

<script>
    function displayAssessments(assessmentID, studentID, markedGrade, autoMark)
    {
        const viewer = document.getElementById("availableAssessmentViewer");

        //Enabling the hiding of the nno assessments added heading
        const noAssessments = viewer.querySelector("#noAssessmentsMessage");
        if (noAssessments) {
            noAssessments.remove();

        }

        const assessmentRow = document.createElement("tr");

        assessmentRow.innerHTML = `
            <td>${assessmentID}</td>
            <td>${studentID}</td>
            <td>${markedGrade !== "" ? markedGrade: "No Mark Given"}</td>
            <td>${autoMark ? "In Progress" : "No Auto Mark"}</td>
            <td><button id="viewImgs" type="button" class="btn btn-sm">IMAGES<i class="fa-solid fa-image"></i></button></td>
        `;

        document
            .querySelector("#availableAssessmentViewer tbody")
            .appendChild(assessmentRow);

    }

</script>

<!--Script to state that functionality does not lie within prototype-->
<script>
    document.getElementById("viewImgs").addEventListener("submit", function (event) {
        alert("Fuctionality Not within prototype");

    });

</script>

