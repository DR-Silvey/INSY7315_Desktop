@using EDAAMS_Desktop.Models.AssessmentModels
@model QuestionVM

@{
    ViewData["Title"] = "Start Assessment Page";
}

@if (Context.Session.GetString("assID") == null || Context.Session.GetString("stdNum") == null || Context.Session.GetString("role") != "STUDENT")
{
    <script>
        alert("Please Log-In as a student and use the provided controls to start an assessment!!!");
        window.location.href = '@Url.Action("Index", "Home")';

    </script>

}

<button class="btn mb-1" data-bs-toggle="modal" data-bs-target="#modalDivReport">REPORT PROBLEM</button>

<div id="assessmentPreview" class="container-fluid d-flex flex-column border p-2">

    <!--Will Display then exam's ID and then a unique student identifier when the exam is hosted now just a preview-->
    <div id="details" class="d-flex flex-row flex-fill align-content-between gap-3">
        <div class="d-flex flex-column">
            <label>Assessment ID:</label>
            <input class="w-auto" type="text" placeholder="@Context.Session.GetString("assID")" title="@Context.Session.GetString("assID")" value="@Context.Session.GetString("assID")" readonly />

        </div>

        <div class="d-flex flex-column">
            <label>Student ID:</label>
            <input class="w-auto" type="text" placeholder="@Context.Session.GetString("stdNum")" title="@Context.Session.GetString("stdNum")" value="@Context.Session.GetString("stdNum")" readonly />

        </div>

    </div>

    <br />

    <div id="assessmentQuestionBody" class="container-fluid d-flex flex-column h-50 p-2" style="overflow-x:hidden; overflow-y: scroll;max-height: 25dvh;">
        <!--For Loop that reads from db then populates a list of exam questions-->
        @if (Model == null)
        {
            <h6>NO QUESTIONS ADDED!!!</h6>

        }
        else
        {
            @foreach (var question in Model.Questions)
            {
                @if (question.IsMultiChoice)
                {
                    <div class="d-flex flex-column">
                        <h6 class="mb-1">Question @question.QuestionNumber</h6>
                        <label>@question.QuestionBody</label>

                        @foreach(string option in question.Options)
                        {
                            <label>@option</label>   
                        }

                    </div>
                    <br />

                }
                else
                {
                    <div class="d-flex flex-column">
                        <h6 class="mb-1">Question @question.QuestionNumber</h6>
                        <label>@question.QuestionBody</label>
                        <textarea></textarea>


                    </div>
                    <br />
                    
                }

            }

            <h6>END OF EXAM ☺</h6>

        }
        
    </div>

</div>
    
<br />

<button class="btn" data-bs-toggle="modal" data-bs-target="#modalDivRequestExamEnd">Request Exam End</button>

<div id="modalDivReport" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body text-start d-flex flex-column justify-content-center">
                <form class="d-flex flex-column p-2" method="post">
                    <label>Problem Description:</label>
                    <textarea required></textarea>

                    <select class="mt-1">
                        <option>Urgency Level <i class="fa-solid fa-arrow-down"></i></option>
                            <option>High</option>
                            <option>Medium</option>
                            <option>Low</option>

                    </select>

                    <br />

                    <button type="submit" class="btn">Submit</button>

                    <input name="stdNum" value="@Context.Session.GetString("stdNum")" type="hidden" required />
                    <input name="assID" value="@Context.Session.GetString("assID")" type="hidden" required />

                </form>

            </div>

        </div>

    </div>
</div>

<div id="modalDivRequestExamEnd" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body text-start d-flex flex-column justify-content-center">
                <form asp-controller="Assessment" asp-action="EndAssessment" method="post" class="d-flex flex-column p-2">
                    <h4 class="align-self-start">Final Confirmation:</h4>

                    <div class="d-flex flex-row gap-2 ">
                        <label>Did you finish all Questions?</label>
                        <input type="checkbox" checked/>

                    </div>

                    <br />

                    <!--Auto Fill-->
                    <div class="d-flex flex-column text-start border p-2">
                        <h6 class="align-self-start">Confirm Details:</h6>

                        <label>Student ID:</label>
                        <input type="text" placeholder="@Context.Session.GetString("stdNum")" title="@Context.Session.GetString("stdNum")" value="@Context.Session.GetString("stdNum")" required />

                        <label>Assessment ID:</label>
                        <input type="text" placeholder="@Context.Session.GetString("assID")" title="@Context.Session.GetString("assID")" value="@Context.Session.GetString("assID")" required />

                    </div>
                    
                    <br />

                    <button class="btn" type="submit">Request Exam End</button>

                </form>

            </div>

        </div>

    </div>
</div>