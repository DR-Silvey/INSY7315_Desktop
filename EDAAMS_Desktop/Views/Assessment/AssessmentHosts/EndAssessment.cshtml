@{
    ViewData["Title"] = "End Assessment Page";
}

@if (Context.Session.GetString("assID") == null || Context.Session.GetString("stdNum") == null || Context.Session.GetString("role") != "STUDENT")
{
    <script>
        alert("Please Log-In as a student and use the provided controls to start an assessment!!!");
        window.location.href = '@Url.Action("Index", "Home")';

    </script>

}

<!--Page Displays when an exam has ended, the student shouldn't be bale to exit this page on their own-->
<h4 class="alert-danger">YOUR ASSESSMENT'S ALOTTED TIME HAS PASSED</h4>

<div class="d-flex flex-column">
    <form class="d-flex flex-column border p-2">
        <label>Enter Termination Code:</label>
        <input />

        <br />
        <button class="btn">MARKS AS COMPLETE</button>

    </form>

    <br />
    <h4>OR</h4>
    <br />

    <!--Hosts a QR that when scanned by a proctors mobile device marks a test as completed and is closed-->
    <form class="d-flex flex-column border p-2">
        <label>SCAN QR CODE TO TERMINATE</label>
        <br />

        @if (1==1)
        {
            <h6>NO Code Generated!!!</h6>

        }

    </form>

</div>